cc_library {
    name: "libarcsoft_beauty_ex",
    srcs: ["libarcsoft_beauty_ex.cpp"],
    shared_libs: [
        "liblog",
    ],
    header_libs: [
        "jni_headers",
    ],
    system_ext_specific: true,
}

cc_library {
    name: "libgui_shim_opluscamera",
    srcs: ["libgui_shim_opluscamera.c"],
    shared_libs: [
        "liblog",
        "libdl",
    ],
    system_ext_specific: true,
    vendor_available: true,
}

cc_library {
    name: "libcamera_device_shim",
    srcs: ["libcamera_device_shim.cpp"],
    shared_libs: [
        "camera.device@3.2-impl",
        "camera.device@3.3-impl",
    ],
    vendor: true,
}
