typeattribute opluscamera_app coredomain;

app_domain(opluscamera_app)
net_domain(opluscamera_app)

# Allow camera app to find standard system services
allow opluscamera_app {
    activity_service
    activity_task_service
    app_function_service
    audio_service
    audioserver_service
    autofill_service
    batteryproperties_service
    batterystats_service
    battery_service
    cameraserver_service
    content_capture_service
    content_service
    device_policy_service
    device_state_service
    gpu_service
    hal_system_suspend_service
    legacy_permission_service
    location_service
    media_communication_service
    media_session_service
    mediaextractor_service
    mediametrics_service
    mediaserver_service
    mount_service
    netstats_service
    notification_service
    power_service
    protolog_configuration_service
    radio_service
    sensitive_content_protection_service
    sensorservice_service
    shortcut_service
    surfaceflinger_service
    thermal_service
    trust_service
    uimode_service
    user_service
    vibrator_service
    vibrator_manager_service
    virtual_device_native_service
    voiceinteraction_service
    webviewupdate_service
    wifi_service
    window_service
}:service_manager find;

# Binder calls
binder_call(opluscamera_app, gpuservice)
binder_call(opluscamera_app, system_suspend_server)

# Allow camera HAL client
not_recovery(`hal_client_domain(opluscamera_app, hal_camera)')
allow opluscamera_app hal_oplus_virtual_camera_hwservice:hwservice_manager find;

# Allow loading camera vendor/odm libraries and configs
allow opluscamera_app same_process_hal_file:file rx_file_perms;
allow opluscamera_app vendor_configs_file:file r_file_perms;
allow opluscamera_app vendor_configs_file:dir r_dir_perms;

# Camera device nodes
allow opluscamera_app gpu_device:chr_file rw_file_perms;

# Properties
get_prop(opluscamera_app, exported_system_prop)
set_prop(opluscamera_app, exported_system_prop)
get_prop(opluscamera_app, vendor_camera_prop)
