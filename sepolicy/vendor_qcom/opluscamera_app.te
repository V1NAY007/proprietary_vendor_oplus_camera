hal_client_domain(opluscamera_app, vendor_hal_dspmanager)

allow opluscamera_app vendor_hal_orms_hwservice:hwservice_manager find;

allow opluscamera_app adsprpcd_file:dir r_dir_perms;
allow opluscamera_app vendor_qdsp_device:chr_file rw_file_perms;
allow opluscamera_app vendor_xdsp_device:chr_file r_file_perms;

r_dir_file(opluscamera_app, vendor_persist_camera_file)
